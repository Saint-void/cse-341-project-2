{
  "swagger": "2.0",
  "info": {
    "title": "Bookstore API",
    "description": "Bookstore REST API. Sign in through GitHub at /auth/github; book and author routes require the resulting session cookie.",
    "version": "1.0.0"
  },
  "host": "cse-341-project-2-gsq0.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "SessionCookie": {
      "type": "apiKey",
      "in": "header",
      "name": "Cookie",
      "description": "Session cookie named bookstore.sid, set after GitHub OAuth login."
    }
  },
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Sign up or log in with GitHub",
        "description": "Redirects to GitHub OAuth. A successful callback creates a local session for the GitHub profile.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub for authorization"
          },
          "503": {
            "description": "GitHub OAuth is not configured"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Complete GitHub login",
        "description": "Handles GitHub authorization and redirects to the authenticated profile endpoint.",
        "responses": {
          "302": {
            "description": "Redirect to /auth/me after successful login"
          },
          "503": {
            "description": "GitHub OAuth is not configured"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get the authenticated GitHub user",
        "description": "",
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "12345"
                    },
                    "username": {
                      "type": "string",
                      "example": "octocat"
                    },
                    "displayName": {
                      "type": "string",
                      "example": "The Octocat"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "description": "Ends the current server-side session and clears its cookie.",
        "responses": {
          "204": {
            "description": "Session ended"
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      }
    },
    "/books/": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get all books",
        "description": "Retrieves an array of all books stored in MongoDB.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of books retrieved successfully",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Book"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create a new book",
        "description": "Creates a new book record with 8 required fields: title, author, isbn, publishedYear, genre, pageCount, rating, language.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Book object to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BookInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Book created successfully with inserted ID"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      }
    },
    "/books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book by ID",
        "description": "Retrieves a single book document matching the specified 24-character hexadecimal ObjectId.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB Book ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Book retrieved successfully",
            "schema": {
              "$ref": "#/definitions/Book"
            }
          },
          "400": {
            "description": "Invalid ID format"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Update a book",
        "description": "Updates an existing book by replacing its document fields.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB Book ObjectId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated book data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BookInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Book updated successfully"
          },
          "400": {
            "description": "Validation failed or invalid ID format"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete a book",
        "description": "Deletes a book document by its 24-character hexadecimal ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB Book ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Book deleted successfully"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      }
    },
    "/authors/": {
      "get": {
        "tags": [
          "Authors"
        ],
        "summary": "Get all authors",
        "description": "Retrieves an array of all authors stored in MongoDB.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of authors retrieved successfully",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Author"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      },
      "post": {
        "tags": [
          "Authors"
        ],
        "summary": "Create a new author",
        "description": "Creates a new author record with required fields: name, bio, nationality, birthYear, website.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Author object to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AuthorInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Author created successfully with inserted ID"
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      }
    },
    "/authors/{id}": {
      "get": {
        "tags": [
          "Authors"
        ],
        "summary": "Get an author by ID",
        "description": "Retrieves a single author document matching the specified 24-character hexadecimal ObjectId.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB Author ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Author retrieved successfully",
            "schema": {
              "$ref": "#/definitions/Author"
            }
          },
          "400": {
            "description": "Invalid ID format"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      },
      "put": {
        "tags": [
          "Authors"
        ],
        "summary": "Update an author",
        "description": "Updates an existing author by replacing its document fields.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB Author ObjectId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated author data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AuthorInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Author updated successfully"
          },
          "400": {
            "description": "Validation failed or invalid ID format"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Authors"
        ],
        "summary": "Delete an author",
        "description": "Deletes an author document by its 24-character hexadecimal ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB Author ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Author deleted successfully"
          },
          "400": {
            "description": "Invalid ID format"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Author not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ]
      }
    }
  },
  "definitions": {
    "Book": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "66e8b2f9024f22f7b8849b3a"
        },
        "title": {
          "type": "string",
          "example": "The Great Gatsby"
        },
        "author": {
          "type": "string",
          "example": "F. Scott Fitzgerald"
        },
        "isbn": {
          "type": "string",
          "example": "978-0743273565"
        },
        "publishedYear": {
          "type": "number",
          "example": 1925
        },
        "genre": {
          "type": "string",
          "example": "Classic Fiction"
        },
        "pageCount": {
          "type": "number",
          "example": 180
        },
        "rating": {
          "type": "number",
          "example": 4.5
        },
        "language": {
          "type": "string",
          "example": "English"
        }
      }
    },
    "BookInput": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "The Great Gatsby"
        },
        "author": {
          "type": "string",
          "example": "F. Scott Fitzgerald"
        },
        "isbn": {
          "type": "string",
          "example": "978-0743273565"
        },
        "publishedYear": {
          "type": "number",
          "example": 1925
        },
        "genre": {
          "type": "string",
          "example": "Classic Fiction"
        },
        "pageCount": {
          "type": "number",
          "example": 180
        },
        "rating": {
          "type": "number",
          "example": 4.5
        },
        "language": {
          "type": "string",
          "example": "English"
        }
      },
      "required": [
        "title",
        "author",
        "isbn",
        "publishedYear",
        "genre",
        "pageCount",
        "rating",
        "language"
      ]
    },
    "Author": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "66e8b2f9024f22f7b8849b3b"
        },
        "name": {
          "type": "string",
          "example": "F. Scott Fitzgerald"
        },
        "bio": {
          "type": "string",
          "example": "Francis Scott Key Fitzgerald was an American novelist and short story writer."
        },
        "nationality": {
          "type": "string",
          "example": "American"
        },
        "birthYear": {
          "type": "number",
          "example": 1896
        },
        "website": {
          "type": "string",
          "example": "https://fscottfitzgerald.org"
        }
      }
    },
    "AuthorInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "F. Scott Fitzgerald"
        },
        "bio": {
          "type": "string",
          "example": "Francis Scott Key Fitzgerald was an American novelist and short story writer."
        },
        "nationality": {
          "type": "string",
          "example": "American"
        },
        "birthYear": {
          "type": "number",
          "example": 1896
        },
        "website": {
          "type": "string",
          "example": "https://fscottfitzgerald.org"
        }
      },
      "required": [
        "name",
        "bio",
        "nationality",
        "birthYear",
        "website"
      ]
    }
  }
}