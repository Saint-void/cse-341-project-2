### Variables
@host = http://localhost:8080
# @host = https://your-render-service.onrender.com

### =========================================================================
### BOOKS COLLECTION (At least 7 fields: title, author, isbn, publishedYear, genre, pageCount, rating, language)
### =========================================================================

### 1. GET all books
GET {{host}}/books HTTP/1.1

### 2. GET single book by ID (Replace with an actual ID from your database)
GET {{host}}/books/66f5c1234567890abcdef123 HTTP/1.1

### 3. POST create book (Valid - 201)
POST {{host}}/books HTTP/1.1
Content-Type: application/json

{
  "title": "To Kill a Mockingbird",
  "author": "Harper Lee",
  "isbn": "978-0061120084",
  "publishedYear": 1960,
  "genre": "Southern Gothic / Fiction",
  "pageCount": 324,
  "rating": 4.8,
  "language": "English"
}

### 4. POST create book with 8 fields (Sample 2 - 1984)
POST {{host}}/books HTTP/1.1
Content-Type: application/json

{
  "title": "1984",
  "author": "George Orwell",
  "isbn": "978-0451524935",
  "publishedYear": 1949,
  "genre": "Dystopian Fiction",
  "pageCount": 328,
  "rating": 4.7,
  "language": "English"
}

### 5. POST create book (Invalid data - missing fields to test 400 validation error)
POST {{host}}/books HTTP/1.1
Content-Type: application/json

{
  "title": "Incomplete Book",
  "genre": "Mystery"
}

### 6. PUT update book (Replace :id with valid MongoDB ObjectId)
PUT {{host}}/books/66f5c1234567890abcdef123 HTTP/1.1
Content-Type: application/json

{
  "title": "To Kill a Mockingbird (Special Edition)",
  "author": "Harper Lee",
  "isbn": "978-0061120084",
  "publishedYear": 1960,
  "genre": "Classic Literature",
  "pageCount": 336,
  "rating": 4.9,
  "language": "English"
}

### 7. PUT update book (Invalid - to test 400 validation error)
PUT {{host}}/books/66f5c1234567890abcdef123 HTTP/1.1
Content-Type: application/json

{
  "title": "Missing required fields"
}

### 8. DELETE book (Replace :id with valid MongoDB ObjectId)
DELETE {{host}}/books/66f5c1234567890abcdef123 HTTP/1.1

### =========================================================================
### AUTHORS COLLECTION (5 fields: name, bio, nationality, birthYear, website)
### =========================================================================

### 9. GET all authors
GET {{host}}/authors HTTP/1.1

### 10. GET single author by ID (Replace with an actual ID from your database)
GET {{host}}/authors/66f5c1234567890abcdef456 HTTP/1.1

### 11. POST create author (Valid - 201)
POST {{host}}/authors HTTP/1.1
Content-Type: application/json

{
  "name": "George Orwell",
  "bio": "Eric Arthur Blair, known by his pen name George Orwell, was an English novelist and essayist.",
  "nationality": "British",
  "birthYear": 1903,
  "website": "https://orwellfoundation.com"
}

